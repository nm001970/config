BOT_TOKEN=YOUR_BOT_TOKEN_HERE
PUBLIC_BASE_URL=http://127.0.0.1:8000
CHANNEL_URL=https://t.me/+s07JAWFSGrI0NDI8

USER_DATABASE_URL=sqlite:///users.db

DEBUG_SUB_RAW=false

API_HOST=127.0.0.1
API_PORT=8000
API_ACCESS_LOG=false

PUBLIC_CONFIGS_FILE=public_configs.json
PUBLIC_HOT_LIMIT=5
PUBLIC_RESERVE_LIMIT=40
SUBSCRIPTION_CONFIG_LIMIT=5
PUBLIC_CANDIDATE_MULTIPLIER=5


# Auto cycle mode: full or smart
AUTO_CYCLE_MODE=full

# Smart cycle settings
SMART_BATCH_LIMIT=5
SMART_CONNECTIVITY_WORKERS=5
SMART_QUALITY_WORKERS=5

# Runtime behavior
AUTO_CYCLE_FILE_LOG=false
SAFE_EXPORT_ALLOW_LAST_GOOD_SUCCESS=true

# Manual raw config delivery in Telegram bot.
# Keep false for subscription-only delivery.
ENABLE_MANUAL_CONFIGS=false

# Shared runtime profile. Use the same codebase on both machines.
# Irancell computer:
CONFIG_DATABASE_URL=sqlite:///configs.db
SMART_BATCH_OPERATOR=irancell
PUBLIC_POOL_OPERATOR=irancell

# V2 Raw/Reserve/Hot processes must run independently from legacy auto_cycle.py.
AUTO_CYCLE_POOL_SUPERVISOR_ENABLED=false
AUTO_CYCLE_POOL_SUPERVISOR_DRY_RUN=true
AUTO_CYCLE_POOL_SUPERVISOR_OPERATOR=irancell

# Subprocess deadlines.
GIT_PUBLISH_COMMAND_TIMEOUT_SECONDS=600
MCI_PUBLISH_COMMAND_TIMEOUT_SECONDS=900
MCI_CYCLE_STEP_TIMEOUT_SECONDS=14400

# On the MCI laptop, override only the effective paths/operator:
# CONFIG_DATABASE_URL=sqlite:///configs_mci.db
# PUBLIC_CONFIGS_FILE=public_configs_mci.json
# SMART_BATCH_OPERATOR=mci
# PUBLIC_POOL_OPERATOR=mci
# AUTO_CYCLE_POOL_SUPERVISOR_OPERATOR=mci
# AUTO_CYCLE_POOL_SUPERVISOR_ENABLED=false